# Copy to .env and fill in. Never commit the real .env.

# HTTP server
PORT=8080
API_KEY=change-me-shared-secret

# CDSC portal
CDSC_BASE=https://iporesult.cdsc.com.np
CDSC_CAPTCHA_DIGITS=5

# Captcha model (ONNX). Trained via backend/train/train.py
CAPTCHA_MODEL_PATH=models/captcha.onnx

# 2Captcha fallback (used only when the model repeatedly fails)
TWOCAPTCHA_API_KEY=
TWOCAPTCHA_ENABLED=true

# Optional proxy if the VPS IP gets WAF-blocked (residential recommended)
# Format: http://user:pass@host:port
CDSC_PROXY=

# Attach to a real Chrome (recommended on Windows when automation is WAF-blocked):
# 1) Close all Chrome windows
# 2) Start: chrome.exe --remote-debugging-port=9222
# 3) Open https://iporesult.cdsc.com.np/ in that window
# 4) Set:
# CHROME_CDP_URL=http://127.0.0.1:9222
CHROME_CDP_URL=
# When not using CDP: chrome | msedge | empty (bundled Chromium)
# Docker/Render: leave empty. Local Windows with real Chrome: chrome
CHROME_CHANNEL=

# Playwright
HEADLESS=true
# Max concurrent CDSC checks (keep low to stay light on the portal)
MAX_CONCURRENCY=2

# Cache
CACHE_DB=cache.sqlite
# Seconds a cached (company, boid) result stays fresh
CACHE_TTL=86400
# CDSC company dropdown cache (SQLite — no Upstash needed)
# Serve list from cache until this age (seconds). Default 6 hours.
CDSC_COMPANIES_CACHE_TTL=21600
# Background live sync interval (seconds). Default 1 hour. Set 0 to disable.
CDSC_COMPANIES_REFRESH_SECONDS=3600

# Auth (Google OAuth + JWT)
DATABASE_URL=sqlite+aiosqlite:///./auth.db
REDIS_URL=
JWT_SECRET=change-me-jwt-secret-min-32-chars-long!!
JWT_ACCESS_TTL=900
JWT_REFRESH_DAYS=30
# Comma-separated Google OAuth client IDs (Android, iOS, Web)
GOOGLE_CLIENT_IDS=
CORS_ORIGINS=*
# When true, CDSC routes require Bearer JWT (API key fallback if false)
CDSC_REQUIRE_JWT=true

# Admin dashboard (seed defaults — editable from admin panel after first login)
ADMIN_EMAIL=prajwaldhital851@gmail.com
ADMIN_PASSWORD=admin123
ADMIN_OTP_TTL_MINUTES=10
APP_ENV=production

# Cron jobs (cron-job.org → POST /app/push/jobs/* with header X-Cron-Secret).
# Falls back to API_KEY if empty. Use the same value in each cron job's headers.
#
# Suggested schedules (NPT):
#   POST /app/push/jobs/market-open          — weekdays 11:00
#   POST /app/push/jobs/market-close         — weekdays 15:05
#   POST /app/push/jobs/price-alerts         — every 10 min, 11:00–15:00 weekdays
#   POST /app/push/jobs/ipo-reminders        — every 15 min (ShareHub auto IPO open/close)
#   POST /app/push/jobs/bulk-transactions    — every 5 min, 11:00–15:00 weekdays
#   POST /app/push/jobs/premium-expiry-reminders — daily 08:00
CRON_SECRET=

# Public HTTPS base URL for push notification images and other absolute links.
PUBLIC_BASE_URL=https://api.nepseghar.com

# Email OTP — Render blocks SMTP. Use HTTP API (not Gmail SMTP):
#
# OPTION A — Resend (easiest to try today, already supported):
#   1) https://resend.com → sign up → API Keys
#   2) Render env:
#        EMAIL_PROVIDER=resend
#        RESEND_API_KEY=re_...
#        RESEND_FROM=onboarding@resend.dev
#      (onboarding@ only delivers to YOUR Resend signup email until you add a domain)
#
# OPTION B — SendGrid (good for production, free ~100/day):
#   1) https://sendgrid.com → Settings → API Keys
#   2) Verify sender or domain under Settings → Sender Authentication
#   3) Render env:
#        EMAIL_PROVIDER=sendgrid
#        SENDGRID_API_KEY=SG....
#        SENDGRID_FROM=noreply@yourdomain.com
#
# OPTION C — Brevo (you may already use this; Gmail→Gmail often spam/deferred):
#   BREVO_API_KEY=...
#   SMTP_FROM=verified@gmail.com
#   EMAIL_PROVIDER=brevo
#
# OPTION D — auto fallback (tries SendGrid → Resend → Brevo → SMTP):
#   EMAIL_PROVIDER=auto
#
# BEST deliverability to Gmail: verify your own domain (e.g. noreply@nepseghar.com)
# on Resend, SendGrid, or Brevo — freemail senders are often blocked by DMARC.
BREVO_API_KEY=
EMAIL_PROVIDER=auto
SENDGRID_API_KEY=
SENDGRID_FROM=
RESEND_API_KEY=
RESEND_FROM=onboarding@resend.dev

# Gmail SMTP (VPS/local only — does NOT work on Render)
# 1) Enable 2-Step Verification on the Gmail account
# 2) Google Account → Security → App passwords → create one for "Mail"
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=kalashfinancialsolution@gmail.com
SMTP_PASSWORD=
SMTP_FROM=kalashfinancialsolution@gmail.com

# Subscription payment details shown in mobile app (initial seed only)
PAYMENT_QR_TEXT=NEPSE GHAR Premium|Kalash Financial Solution
PAYMENT_BANK_NAME=Kalash Financial Solution Pvt. Ltd.
PAYMENT_ACCOUNT_NAME=Kalash Financial Solution
PAYMENT_ACCOUNT_NUMBER=0123456789
PAYMENT_WHATSAPP=9779709133067
