EXPO_PUBLIC_AUTH_ENABLED=true
# Optional local dev only — production APKs require Google sign-in to add accounts.
EXPO_PUBLIC_GUEST_CAN_ADD_ACCOUNTS=false
EXPO_PUBLIC_AUTH_API_URL=https://api.nepseghar.com
EXPO_PUBLIC_CDSC_BACKEND_URL=https://api.nepseghar.com
EXPO_PUBLIC_CDSC_BACKEND_KEY=your-backend-key
# Optional last-resort captcha fallback on the phone (paid). Server ONNX + 2Captcha
# on VPS is tried first; mobile 2Captcha runs only after all free solvers fail.
# EXPO_PUBLIC_TWOCAPTCHA_API_KEY=
# EXPO_PUBLIC_TWOCAPTCHA_ENABLED=true
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=your-web-client-id.apps.googleusercontent.com
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=your-android-client-id.apps.googleusercontent.com
EXPO_PUBLIC_PREMIUM_BYPASS=false
