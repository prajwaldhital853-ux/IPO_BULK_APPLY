# Shrink EAS upload — not needed for the Android APK build
android/
ios/
.expo/
.claude/
node_modules/.cache/**

# Built APKs / artifacts (were bloating the archive to ~470MB)
*.apk
*.aab
NEPSE-GHAR-*.apk
nepse-ghar-*.apk
apk-build.log
apk-url.txt
eas-build-*.json
build-fail-log*
build-fail-log.*
build-fail.json
build-meta.json
build-meta-*.txt
bundle-*.js
_tmp_stock.html

# Local tooling / caches
.expo-shared/
coverage/
*.log
*.map

# Parent monorepo noise if archive walks up
../backend/
../website/
../landing/
../**/*.apk
../**/*.aab
